# ──────────────────────────────────────────────
# .gitignore — Deployment branch
# Más restrictivo que master; excluye todo lo que
# pueda comprometer seguridad o no sea necesario
# en producción.
# ──────────────────────────────────────────────

# === Django ===
*.pyc
__pycache__/
*.db
*.sqlite3

# === Environment (NUNCA subir .env a git) ===
.env
.env.production
.env.*.local

# === Secrets & Keys ===
**/ssl/
**/ssl/*
nginx/ssl/
!nginx/ssl/.gitkeep
*.key
*.pem
*.cert
*.crt

# === Node / Frontend ===
frontend/node_modules/
frontend/.angular/
frontend/dist/

# === Python ===
venv/
.venv/
*.egg-info/

# === Media (uploaded by users) ===
media/

# === Django static (generated by collectstatic) ===
staticfiles/

# === Docker ===
docker-data/

# === IDE / OS ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# === Secrets in any file ===
# Prevent accidental commit of files with "secret" in name
**/secret*
**/secrets*
