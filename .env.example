DEBUG=True
SECRET_KEY=your-secret-key-here
DJANGO_ALLOWED_HOSTS=*

DB_NAME=appiglesia
DB_USER=appiglesia
DB_PASSWORD=appiglesia
DB_HOST=db
DB_PORT=5432

# IP de tu PC en la red local (para HTTPS desde el celular)
HOST_IP=192.168.0.12,100.86.12.12

# OpenWA WhatsApp API
# Django autodescubre la key real desde /openwa_data/.api-key,
# pero OPENWA_API_KEY sirve como fallback.
# En desarrollo la key fija es: dev-admin-key
OPENWA_BASE_URL=http://openwa:2785/api
OPENWA_API_KEY=dev-admin-key
OPENWA_SESSION_ID=default
