# ──────────────────────────────────────────────
# App Iglesia — Variables de Entorno
# Copia este archivo como .env y ajusta valores
# ──────────────────────────────────────────────

# === Django ===
DEBUG=True
SECRET_KEY=django-insecure-dev-fallback-key-not-for-production
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# === PostgreSQL ===
DB_NAME=appiglesia
DB_USER=appiglesia
DB_PASSWORD=appiglesia
DB_HOST=db
DB_PORT=5432

# === OpenWA WhatsApp API ===
# Django autodescubre la key real desde /openwa_data/.api-key,
# pero OPENWA_API_KEY sirve como fallback.
# En desarrollo la key fija del contenedor OpenWA es: dev-admin-key
OPENWA_BASE_URL=http://openwa:2785/api
OPENWA_API_KEY=dev-admin-key
OPENWA_SESSION_ID=default
OPENWA_COUNTRY_CODE=57
