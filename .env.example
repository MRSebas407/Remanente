# ──────────────────────────────────────────────
# App Iglesia — Variables de Entorno
# Copia este archivo como .env y ajusta valores
# ──────────────────────────────────────────────

# === Django ===
DEBUG=True
SECRET_KEY=django-insecure-dev-fallback-key-not-for-production
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# === DNS local (Tailscale) ===
# IP de Tailscale del servidor (100.x.x.x)
# Se necesita para que dnsmasq resuelva www.remanente.com
SERVER_TAILSCALE_IP=

# === PostgreSQL ===
DB_NAME=appiglesia
DB_USER=appiglesia
DB_PASSWORD=appiglesia
DB_HOST=db
DB_PORT=5432

# === OpenWA ===
OPENWA_DB_PASSWORD=openwa_dev

# === OpenWA WhatsApp API ===
OPENWA_BASE_URL=http://openwa:2785/api
OPENWA_API_KEY=dev-admin-key
OPENWA_SESSION_ID=default
OPENWA_COUNTRY_CODE=57
