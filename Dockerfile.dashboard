FROM node:20-alpine AS builder

RUN apk add --no-cache git && \
    git clone --depth 1 https://github.com/rmyndharis/OpenWA.git /openwa

WORKDIR /openwa/dashboard
RUN npm ci && npm run build

FROM nginx:alpine
COPY --from=builder /openwa/dashboard/dist /usr/share/nginx/html
COPY --from=builder /openwa/dashboard/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
